<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MiPrimeraApp.MainPage">
 
    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="20"
            VerticalOptions="Center">
 
            <Label
                Text="¡Bienvenido!"
                FontSize="28"
                HorizontalOptions="Center" />
 
            <Label
                x:Name="saludoLabel"
                Text="Escribe tu nombre y presiona el botón"
                FontSize="16"
                HorizontalOptions="Center" />
 
            <Entry
                x:Name="nombreEntry"
                Placeholder="Escribe tu nombre aquí"
                FontSize="16" />
 
            <Button
                x:Name="saludarBtn"
                Text="Saludar"
                Clicked="OnSaludarClicked"
                HorizontalOptions="Center" />
 
        </VerticalStackLayout>
    </ScrollView>
 
</ContentPage>

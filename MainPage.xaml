<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MiPrimeraApp.MainPage">
 
    
    <VerticalStackLayout
        Padding="30,0"
        Spacing="20"
        
        VerticalOptions="Center">
 
        <Label
        Text="Selecciona una fruta"
        FontSize="24"
        HorizontalOptions="Center" />
 
        <!--El elemento CollectionView nos muestra la lista de frutas que se han creado-->
        <CollectionView
            x:Name="frutasCollectionView"
            ItemsSource="{Binding Frutas}"
            SelectionMode="Single"
            SelectionChanged="OnFrutaSeleccionada">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="15" Margin="0,5">
                        <Label Text="{Binding Nombre}" FontSize="18" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


    </VerticalStackLayout>
    
</ContentPage>
